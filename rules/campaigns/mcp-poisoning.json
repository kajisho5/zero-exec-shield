{
  "campaign": "mcp-poisoning",
  "incident_bundle": "ZES-2026-OCT-EMERGENCY-V5.2",
  "source": "rules/ioc.json（本ファイルは複製。正はioc.json）",
  "campaigns": [
    "mcp-poisoning"
  ],
  "packages": [],
  "iocs": {
    "mcp_poisoning": {
      "campaign": "mcp-poisoning",
      "symjack": {
        "target_configs": [
          ".mcp.json",
          ".cursor/mcp.json",
          ".claude/settings.json",
          ".gemini/settings.json",
          ".codex/config.toml"
        ],
        "example_payloads": [
          "ln -s ../.claude/settings.json docs/vid-settings.mp4",
          "ln -sf ../../.mcp.json docs/vid-mcp.mp4"
        ],
        "decoy_name_patterns": [
          "vid-",
          "logo.",
          "readme.",
          "docs/"
        ]
      },
      "runtime_gate": {
        "alias": "Deadbugz",
        "behavior": "最初の3回正常、4回目以降に悪性実行",
        "detection_regex": [
          "callCount\\s*>\\s*[0-9]+",
          "invocations?\\s*>\\s*[0-9]+",
          "count\\+\\+.*if\\s*\\(\\s*count\\s*>"
        ],
        "injection_phrases": [
          "ignore previous instructions",
          "do not tell the user",
          "execute"
        ]
      },
      "neighbor": {
        "alias": "NeighborJack",
        "behavior": "MCP サーバーが 0.0.0.0 で待ち受け、同一 LAN から到達できる設定不備（Backslash, 2025-06）",
        "detection": "0.0.0.0 での待ち受け（一次情報の定義）、およびループバック以外の内部 IP・平文 HTTP の MCP エンドポイント登録（ZES 追加）",
        "internal_ip_regex": "(10\\.[0-9]+\\.[0-9]+\\.[0-9]+|192\\.168\\.[0-9]+\\.[0-9]+|172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]+\\.[0-9]+)"
      },
      "registry_supply_chain": {
        "tool": "SPECTER MCP-POISON",
        "cves": [],
        "note": "CVE-2026-52869 / CVE-2026-58500 はレジストリ汚染の事案ではないため mcp_cves に移動"
      },
      "mcp_cves": [
        {
          "id": "CVE-2026-104850",
          "title": "MCP TS SDK OAuth偽装"
        },
        {
          "id": "CVE-2026-104120",
          "title": "mcp-server-fetch/everything fetch_url"
        },
        {
          "id": "CVE-2026-111767",
          "title": "InMemoryTaskStore アクセス制御不備"
        },
        {
          "id": "CVE-2026-59951",
          "title": "FastMCP セッション蓄積"
        },
        {
          "id": "CVE-2026-61559",
          "title": "gitlab-mcp サーバーサイド"
        },
        {
          "id": "CVE-2026-52869",
          "cvss": 7.1,
          "title": "MCP Python SDK: セッション ID と認証主体が紐付かない",
          "eco": "pypi",
          "package": "mcp",
          "fixed": "1.27.2",
          "ghsa": "GHSA-jpw9-pfvf-9f58"
        },
        {
          "id": "CVE-2026-58500",
          "cvss": 8.2,
          "title": "appium-mcp: locator UI の XSS",
          "eco": "npm",
          "package": "appium-mcp",
          "fixed": "1.85.10",
          "ghsa": "GHSA-x975-rgx4-5fh4"
        }
      ],
      "toolhive_ssrf": {
        "cves": [
          "GO-2026-5996",
          "GO-2026-6002",
          "CVE-2026-58197"
        ],
        "description": "GO-2026-5996: IPv6 NAT64 レンジの見逃し。GO-2026-6002（CVE-2026-58196）: 認証ディスカバリ経路の SSRF。host.docker.internal 経由の横移動は別件の CVE-2026-58197",
        "patterns": [
          "host.docker.internal",
          "64:ff9b::",
          "64:ff9b:1:"
        ]
      },
      "config_paths": [
        "~/.cursor/mcp.json",
        "~/.claude/mcp.json",
        ".vscode/settings.json",
        "~/.config/github-copilot/"
      ],
      "suspicious_commands": [
        "curl",
        "wget",
        "npx",
        "uvx",
        "node -e",
        "bash -c",
        "powershell -enc"
      ],
      "ide_hook": ".vscode/tasks.json / .claude/tasks.json の runOn: folderOpen"
    }
  },
  "malicious_files": []
}
